"""Root package: the krabka Kubernetes operator."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Cargo.lock/Cargo.toml are consumed by `crate.from_cargo` (see //MODULE.bazel);
# clippy.toml by the lint aspect in //tools/lint; .cargo/mutants.toml by the
# mutation sweep, via `--@rules_rs_mutants//mutants:config` in //.bazelrc.
exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
])

# `bazel run //:krabka-operator -- gen-crds ./target/crds`.
alias(
    name = "krabka-operator",
    actual = "//crates/krabka-operator:krabka-operator",
)

sh_test(
    name = "kind_lifecycle_test",
    size = "enormous",
    srcs = ["packaging/kind-lifecycle.sh"],
    data = glob([
        "charts/krabka-operator/**",
        "packaging/Dockerfile",
    ]),
    tags = [
        "docker",
        "external",
        "no-sandbox",
    ],
)
