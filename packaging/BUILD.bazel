"""The operator container image.

apko builds the locked Wolfi base. rules_img adds the Bazel-built operator
binary and owns both local loading and registry delivery. This is the image
shape that krabka-broker uses.

    bazel run -c opt //packaging:image_load     # load into the local daemon
    bazel run -c opt //packaging:push -- --tag dev

The base is locked in `base.apko.lock.json`. After a change to
`base.apko.yaml`, or to refresh the Wolfi packages, write the lock again with
apko v1.2.40 (the version //MODULE.bazel registers):

    apko lock packaging/base.apko.yaml --output packaging/base.apko.lock.json
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# //:kind_lifecycle_test runs this script. The test stays in the root package,
# next to the chart that it installs.
exports_files(["kind-lifecycle.sh"])

# The tag that `image_load` gives the image in the local daemon. The kind
# lifecycle test installs the chart with this image, as `krabka-operator:e2e`.
# A push supplies its own tags.
#
# The name is fully qualified. A Docker daemon with the containerd image store
# keeps the name from the tarball as it is. A short name then sits beside
# `docker.io/library/krabka-operator:e2e`, and `docker run krabka-operator:e2e`
# resolves to the qualified one, which can be an older image.
IMAGE_TAG = "docker.io/library/krabka-operator:e2e"

# The one architecture that this image is built and published for.
# `base.apko.yaml` names it too.
IMAGE_ARCH = "amd64"

# Owned by `nonroot` in the apko base. The operator needs no privilege.
NONROOT = file_metadata(
    gid = 65532,
    mode = "0755",
    uid = 65532,
)

apko_image(
    name = "base_oci",
    config = "base.apko.yaml",
    contents = "@operator_base_lock//:contents",
    tag = "krabka-operator-base:locked",
)

image_manifest_from_oci_layout(
    name = "base",
    src = ":base_oci",
    architecture = IMAGE_ARCH,
    layers = [GZIP_LAYER],
    os = "linux",
)

image_layer(
    name = "operator_layer",
    srcs = {
        "/usr/bin/krabka-operator": "//crates/krabka-operator:krabka-operator",
    },
    default_metadata = NONROOT,
    include_runfiles = False,
)

# The layer carries whatever the host toolchain built, with no platform
# transition, and the manifest always says linux/amd64. The constraint makes
# `bazel build //...` skip the image on any other host, so it cannot wrap a
# binary for a different CPU.
image_manifest(
    name = "image",
    base = ":base",
    entrypoint = ["/usr/bin/krabka-operator"],
    layers = [":operator_layer"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    user = "65532:65532",
)

image_load(
    name = "image_load",
    image = ":image",
    tag = IMAGE_TAG,
)

# Loads the image into a real daemon and runs the binary under the base
# image's own loader and libc. A binary that links against a library the base
# does not carry fails here. It needs a Docker daemon, so it has the `docker`
# tag and `bazel test //...` skips it:
#
#     bazel test -c opt --config=docker //packaging:image_docker_test
sh_test(
    name = "image_docker_test",
    size = "medium",
    srcs = ["image_docker_test.sh"],
    args = [
        "$(rootpath :image_load)",
        IMAGE_TAG,
    ],
    data = [":image_load"],
    # `no-sandbox` for the daemon socket. `external` so that a pass is never
    # cached against inputs that do not describe the state of the daemon.
    tags = [
        "docker",
        "external",
        "no-sandbox",
    ],
)

# The binary in the image reports the version of the root Cargo.toml. The
# operator also puts that version into default image tags. The test needs no
# daemon, so `bazel test //...` runs it.
sh_test(
    name = "version_test",
    size = "small",
    srcs = ["version_test.sh"],
    args = [
        "$(rootpath //crates/krabka-operator:krabka-operator)",
        "$(rootpath //:Cargo.toml)",
    ],
    data = [
        "//:Cargo.toml",
        "//crates/krabka-operator",
    ],
)

# CI supplies the tags on the command line, so a push from main publishes an
# immutable commit tag.
image_push(
    name = "push",
    image = ":image",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-operator",
)
