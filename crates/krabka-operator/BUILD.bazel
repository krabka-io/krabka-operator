load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "krabka_operator")

# `bazel run //:krabka-operator -- gen-crds ./target/crds`.
crate_binary(
    name = "krabka-operator",
    crate_root = "src/main.rs",
    lib = ":krabka_operator",
)

crate_tests(lib = "krabka_operator")
